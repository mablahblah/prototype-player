{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "out/html-conversions",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}
